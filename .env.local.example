NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Google Gemini — free tier at https://aistudio.google.com/apikey (no credit card required)
GOOGLE_AI_API_KEY=

# News provider — set one. Defaults to NewsAPI when both are present.
NEWSAPI_KEY=
FINNHUB_API_KEY=

# FRED — free key from https://fredaccount.stlouisfed.org/apikey
# Required for the Macro Dashboard and Economic Calendar pages.
FRED_API_KEY=

# Calendar — required for the /api/cron/* endpoints in production. In dev, leave
# unset to bypass the auth check. In production set to a long random string and
# Vercel will pass it as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=

# Stripe (test mode for now). Keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=
# Price IDs from Stripe Dashboard → Products → FinHub Pro (monthly + yearly)
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Used for absolute redirect URLs from Stripe Checkout. Optional.
NEXT_PUBLIC_SITE_URL=https://finhub-self.vercel.app
